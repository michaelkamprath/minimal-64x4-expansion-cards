(footprint "Minimal64x4_Expansion_Card_Connector"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Minimal 64x4 expansion card connector: right-angle 2x16 pin header, 2.54 mm. Pin numbering is rotated 180 degrees from the stock PinHeader_2x16_P2.54mm_Horizontal (pin 1 at the far end) so the right-angle header mates correctly with the Minimal's expansion port and the expansion backplane. Use this for every card's CN1.")
	(tags "Minimal 64x4 expansion card edge connector right angle 2x16")
