#ifdef FAST_DIVISION
; per-ray slope caches for the view angle in 'cacheangle':
; 200 LSBs followed by 200 MSBs each, indexed by rayindex (via LAB)
stepcache_x:  .zero 400
stepcache_y:  .zero 400
#endif
#mute

.org 0x0040     ; zero-page variables and constants

startup:        .byte 0x00
dir_a:          .2byte 0x0000
dir_b:          .2byte 0x0000
dx:             .2byte 0x0000
dy:             .2byte 0x0000
signdx:         .byte 0x00
signdy:         .byte 0x00
angle:          .byte 0x00
s:              .2byte 0x0000
face:           .byte 0x00
id:             .byte 0x00
lastid:         .byte 0x00
wall:           .byte 0x00
lastwall:       .byte 0x00
w:              .byte 0x00
px:             .2byte 0x0000 ; player's position
py:             .2byte 0x0000
x:              .2byte 0x0000 ; ray's position
y:              .2byte 0x0000
nx:             .2byte 0x0000
ny:             .2byte 0x0000
ix:             .2byte 0x0000 ; distance to next cell boundary
iy:             .2byte 0x0000
stepy_x:        .2byte 0x0000 ; y-Schritt über Zelle: nötige Schrittweite in x
stepx_y:        .2byte 0x0000 ; x-Schritt über Zelle: nötige Schrittweite in y
nexty_x:        .2byte 0x0000 ; y-Schritt zum Zellenrand: nötige Schrittweite in x
nextx_y:        .2byte 0x0000 ; x-Schritt zum Zellenrand: nötige Schrittweite in y
#ifdef FAST_DIVISION
rayindex:       .byte 0x00 ; current ray index (0..199) into the slope caches
cacheangle:     .byte 0x00 ; view angle the slope caches were built for
; note: the stepdiv_x/y cache-write pointer reuses nx, which is only used by the move-key handlers
#endif

.org 0x0070

z_a:            .byte 0x00, 0x00, 0x00, 0x00 ; zero-page math registers
z_b:            .byte 0x00, 0x00
z_c:            .byte 0x00, 0x00, 0x00, 0x00
sign:           .byte 0x00
cnt:            .byte 0x00

xa:             .2byte 0x0000 ; zero-page graphics register
ya:             .byte 0x00
yb:             .byte 0x00
index:          .2byte 0x0000
pattern:        .byte 0x00
stride:         .byte 0x00

#emit
