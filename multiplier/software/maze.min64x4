; --------------------------------------------------------------------------------------
; 3D Maze Demo written by Carsten Herting (slu4) 2026/06/29 - 2026/07/10 in Boersmose/DK
; This code renders a classic 16 x 16 cell maze using a simple ray-casting technique.
; Ported to Minimal 64x4 1.1 instruction set 2026/07/12 by slu4.
; --------------------------------------------------------------------------------------
; Update by Michael Kamprath to a) be compiled by BespokeASM and b) optionally
; use the hardware multiplier card.
; --------------------------------------------------------------------------------------

#ifdef USE_ACCELERATOR
#print yellow "Compiling with support for multiplier card"
; Hardware multiplier accelerator memory-mapped registers
MULTIPLIER_A = $FED0            ; Input register for 8-bit multiplicand A
MULTIPLIER_B = $FED1            ; Input register for 8-bit multiplicand B
MULTIPLIER_RESULT_LSB = $FED2   ; Output register for LSB of 16-bit result
MULTIPLIER_RESULT_MSB = $FED3   ; Output register for MSB of 16-bit result
#endif

#ifdef FAST_DIVISION
#print red "Compiling with fast division algorithms"
#endif

.org $2000
                MIZ 0x0a,angle ; set the initial view angle
                MIV 0x0181,px ; set the initial viewer's position
                MIV 0x0182,py
                MIZ 0,startup
#ifdef FAST_DIVISION
                CLZ rayindex ; init slope-cache state
                LDZ angle NOT STZ cacheangle ; force a slope-cache rebuild on the first frame
#endif

drawloop:       JPS render
                CIZ 0,startup FNE keyloop
                  MIZ 14,_XPos MIZ 2,_YPos JPS _Print   "R A Y - C A S T I N G"
                  MIZ 14,_XPos MIZ 5,_YPos JPS _Print   "3 D  M A Z E  D E M O"
                  MIZ 14,_XPos MIZ 8,_YPos JPS _Print   "    by slu4 2026"
#ifdef USE_ACCELERATOR
                  MIZ 14,_XPos MIZ 11,_YPos JPS _Print  " harware accelerated"
#endif
                  MIZ 13,_XPos MIZ 24,_YPos JPS _Print  "Use WASD to move around."
                  MIZ 1,startup
                  
  keyloop:      WIN INK
                CPI 0x1c FNE testd ; PS/2 'A'
                  SIZ 4,angle FPA drawloop
  testd:        CPI 0x23 FNE testw ; PS/2 'D'
                  AIZ 4,angle FPA drawloop
  testw:        CPI 0x1d FNE tests ; PS/2 'W'
                  JPS make16bitdir
                  MVV px,nx MVV py,ny
                  AVV dir_a,nx AVV dir_b,ny
    dothestep:    LDZ ny+1 LL4 ADZ nx+1 LAP BYTE1(maze) CPI 0 FNE drawloop
                    MVV nx,px MVV ny,py
                  FPA drawloop
  tests:        CPI 0x1b FNE keyloop ; PS/2 'S'
                  JPS make16bitdir
                  MVV px,nx MVV py,ny
                  SVV dir_a,nx SVV dir_b,ny
                  JPA dothestep

make16bitdir:     LDZ dir_a LL1 LDI 0xff ACI 0 NOT STZ dir_a+1 ; make signed 16-bit
                  LDZ dir_b LL1 LDI 0xff ACI 0 NOT STZ dir_b+1
                  LDZ dir_a+1 LL1 RRZ dir_a+1 RRZ dir_a+0 ; 16-bit arithmetic shift right
                  LDZ dir_a+1 LL1 RRZ dir_a+1 RRZ dir_a+0
                  LDZ dir_b+1 LL1 RRZ dir_b+1 RRZ dir_b+0
                  LDZ dir_b+1 LL1 RRZ dir_b+1 RRZ dir_b+0
                  RTS

.align
; -------------------------------------------------------------
; renders a scene from position (px, py) with direction 'angle'
; -------------------------------------------------------------
  render:       CLV lastid CLZ lastwall
                MIV -200,s
                LZB angle,costable STZ dir_a
                LZB angle,sintable STZ dir_b
                JPS _Clear

  rayloop:      LDZ dir_a LL1 STZ dx+0                             ; calculate dx = a<<1 with sign
                LDI 0xff ACI 0 NOT STZ dx+1
                LDZ dir_b LL1 STZ dy+0                             ; calculate dy = b<<1 with sign
                LDI 0xff ACI 0 NOT STZ dy+1

    dodx:       MZZ dir_b,z_a+0 MVV s,z_b
                JPS muls8_16f LLQ z_c                          ; (b*s) >> 7 = shifting up 1 step and using z_c+1..
                CIZ 0,sign FPL bspos
                  AVV z_c+1,dx FPA dody
      bspos:    SVV z_c+1,dx

    dody:       MZZ dir_a,z_a+0 MVV s,z_b
                JPS muls8_16f LLQ z_c                          ; (a*s) >> 7 = shifting up 1 step and using z_c+1..
                CIZ 0,sign FMI asneg
                  AVV z_c+1,dy FPA initray
      asneg:    SVV z_c+1,dy


    initray:    MVV px,x MVV py,y                             ; set ray's origin


      checkdx:  CIZ 0,dx+1 FPL dxpos
                  MIZ 0x80,signdx
                  NEV dx MZZ x+0,ix FPA checkdy

        dxpos:  MIZ 0x00,signdx
                LDZ x+0 NOT STZ ix

      checkdy:  CIZ 0,dy+1 FPL dypos
                  MIZ 0x80,signdy
                  NEV dy MZZ y+0,iy FPA checkdxzero

        dypos:  MIZ 0x00,signdy
                LDZ y+0 NOT STZ iy


  checkdxzero:  LDZ dx+0 ORZ dx+1 CPI 0 FNE dxnotzero
                  MIV 0xffff,nextx_y MIV 0xffff,stepx_y FPA checkdyzero
    dxnotzero:  CLQ z_a MVV dy,z_a+1 MVV dx,z_b JPS stepdiv_x ; stepdiv_x = divu17_16f unless FAST_DIVISION
                LDZ z_c+2 ORZ z_c+3 CPI 0 FEQ dxnotover
                  MIV 0xffff,stepx_y FPA dxdonext
    dxnotover:  MVV z_c,stepx_y
    
    dxdonext:   MZZ ix,z_a MVV stepx_y,z_b JPS mulu8_16f
                CIZ 0,z_c+3 FEQ dxnotover2
                  MIV 0xffff,nextx_y FPA checkdyzero
    dxnotover2: MVV z_c+1,nextx_y


  checkdyzero:  LDZ dy+0 ORZ dy+1 CPI 0 FNE dynotzero
                  MIV 0xffff,nexty_x MIV 0xffff,stepy_x JPA castloop
    dynotzero:  CLQ z_a MVV dx,z_a+1 MVV dy,z_b JPS stepdiv_y ; stepdiv_y = divu17_16f unless FAST_DIVISION
                LDZ z_c+2 ORZ z_c+3 CPI 0 BEQ dynotover
                  MIV 0xffff,stepy_x FPA dydonext
    dynotover:  MVV z_c,stepy_x
    
    dydonext:   MZZ iy,z_a MVV stepy_x,z_b JPS mulu8_16f
                CIZ 0,z_c+3 FEQ dynotover2
                  MIV 0xffff,nexty_x FPA castloop
    dynotover2: MVV z_c+1,nexty_x

; --------------------------------------------------

    castloop:   MVV nextx_y,z_a AZV ix,z_a FCS zagreater ; eval cell boundary crossings
                MVV nexty_x,z_b AZV iy,z_b FCS zasmaller ; watch out for overflows here!
                  CZZ z_a+1,z_b+1 FGT zasmaller FCC zagreater ; 1.4: CVV z_a,z_b FCC zagreater
                    CZZ z_a+0,z_b+0 FCC zagreater
                
      zasmaller:  CIZ 0,signdx FPL cl_dxpos ; case ix + nextx_y < iy + nexty_x
                    SZV ix,x DEV x
        cl_testdy:  CIZ 0,signdy FPL cl_dypos1
                      SVV nextx_y,y FPA cl_done1
        cl_dypos1:  AVV nextx_y,y FPA cl_done1
      cl_dxpos:     AZV ix,x INV x FPA cl_testdy

      cl_done1:     SVV nextx_y,iy FPL okay1
                      CLV iy
        okay1:      SZV ix,nexty_x FCS okay2
                      CLV nexty_x
        okay2:      MIZ 0xff,ix
                    MVV stepx_y,nextx_y
                    MIZ 0,face
                    FPA testinside
                    
      zagreater:  CIZ 0,signdy FPL cl_dypos2 ; case ix + nextx_y >= iy + nexty_x
                    SZV iy,y DEV y
        cl_testdx:  CIZ 0,signdx FPL cl_dxpos1
                      SVV nexty_x,x FPA cl_done2
        cl_dxpos1:  AVV nexty_x,x FPA cl_done2
      cl_dypos2:    AZV iy,y INV y FPA cl_testdx

      cl_done2:     SVV nexty_x,ix FPL okay3
                      CLV ix
        okay3:      SZV iy,nextx_y FCS okay4
                      CLV nextx_y
        okay4:      MIZ 0xff,iy
                    MVV stepy_x,nexty_x
                    MIZ 1,face
      
      testinside: LDZ y+1 LL4 ADZ x+1 LAP BYTE1(maze) ; while(arr[y>>8][x>>8] == 0)
                  CPI 0 FEQ castloop

; --------------------------------------------------

                  LDZ y+1 LL2 STZ id LDZ x+1 LL1 AD.Z id AZZ face,id ; calculate wall id

                  ; calculate wall height
                  LRZ dx+1 RRZ dx+0 ; dx = dx >> 1; dx/dy are now unsigned 8 bit again
                  LRZ dy+1 RRZ dy+0 ; dy = dy >> 1
                  CZZ dx,dy FCS dygreater

      dxgreater:  MVV x,z_b SVV px,z_b FPL dpos1 ; case dx > dy
                    NEV z_b FCC dpos1
                      MIZ 1,z_b+0
        dpos1:    CLQ z_a MZZ dx,z_a+1 ; set divident
                    FPA calcwall
              
      dygreater:  MVV y,z_b SVV py,z_b FPL dpos2 ; case dy > dx
                    NEV z_b FCC dpos2
                      MIZ 1,z_b+0
        dpos2:    CLQ z_a MZZ dy,z_a+1 ; set divident

      calcwall:   JPS divu17_16f
                  LDZ z_c+1 ORZ z_c+2 CPI 0 FEQ wallio ; check for wall height > 0xff
                    MIZ 0xff,wall FPA drawit ; set max wall height

        wallio:   MZZ z_c+0,wall

; --------------------------------------------------

    drawit:       MVV s,xa AIV 200,xa ; always set xa drawing position
                  
                  LDZ xa+1 DEC LDZ xa+0 RL6 ANI 63 STZ stride ; pre-calculate x-stride
                  LDZ xa+0 ANI 7 RAP BYTE1(0x0000),1 STZ pattern    ; pre-calculate bit pattern

                  CIZ 120,wall FLE drawpixel ; check for clipping
                    MIZ 120,wall FPA checkline ; skip pixel drawing
      drawpixel:  MIZ 120,ya SZZ wall,ya JPS SetPixel
                  MIZ 119,ya AZZ wall,ya JPS SetPixel

                  CIZ 0,lastwall FEQ devandcheck
                    LRZ pattern FCC patokay
                      MIZ 0x80,pattern DEZ stride

      patokay:      LDZ lastwall ADZ wall LR1 STZ w ; w = (lastwall + wall)>>1
                    MIZ 120,ya SZZ w,ya JPS SetPixel
                    MIZ 119,ya AZZ w,ya JPS SetPixel
                    FPA checkline

    devandcheck:  LRZ pattern FCC checkline
                      MIZ 0x80,pattern DEZ stride

    checkline:    CIZ 0,lastid FEQ enddone ; draw a vertical line between blocks
                    CZZ id,lastid FEQ enddone
                      CZZ wall,lastwall FCS wlessoreq ; if (wall > lastwall) w = wall; else w = lastwall;
                        MZZ wall,w FPA wdone
      wlessoreq:      MZZ lastwall,w
      wdone:          MIZ 121,ya SZZ w,ya
                      LDZ w DEC LL1 STZ yb JPS VertLine

      enddone:  MZZ id,lastid MZZ wall,lastwall

#ifdef FAST_DIVISION
                INZ rayindex ; advance to the next ray's slope-cache slot
#endif
                AIV 2,s BMI rayloop ; draw the next ray
                  CIZ 200,s+0 BCC rayloop
#ifdef FAST_DIVISION
                    CLZ rayindex MZZ angle,cacheangle ; slope caches now valid for 'angle'
#endif
                    RTS

#ifdef FAST_DIVISION
.align
; ---------------------------------------------------------------------------
; stepdiv_x/y: the two slope divides with per-view-angle caching.
; The step values depend only on 'angle' and the ray index, not on the player
; position, so walking (W/S) can reuse the previous frame's results. The cache
; is refilled during the first rendered frame after 'angle' changes.
; Interface matches divu17_16f as used by the slope call sites: returns the
; final (already clamped) step value in z_c+0..1 with z_c+2/z_c+3 = 0, so the
; callers' overflow clamp check passes through benignly.
; ---------------------------------------------------------------------------
stepdiv_x:      CZZ angle,cacheangle FEQ sdx_hit
                  JPS divu17_16f                             ; cache miss: really divide
                  LDZ z_c+2 ORZ z_c+3 CPI 0 FEQ sdx_store
                    MIV 0xffff,z_c CLZ z_c+2 CLZ z_c+3       ; clamp so the cache holds the final value
  sdx_store:      MIV stepcache_x,nx AZV rayindex,nx     ; store into this ray's cache slot
                  LDZ z_c+0 STT nx
                  AIV 200,nx
                  LDZ z_c+1 STT nx
                  RTS
  sdx_hit:      LDZ rayindex LAB stepcache_x STZ z_c+0       ; cache hit: fetch stored step value
                LDZ rayindex LAB stepcache_x+200 STZ z_c+1
                CLZ z_c+2 CLZ z_c+3
                RTS

stepdiv_y:      CZZ angle,cacheangle FEQ sdy_hit
                  JPS divu17_16f
                  LDZ z_c+2 ORZ z_c+3 CPI 0 FEQ sdy_store
                    MIV 0xffff,z_c CLZ z_c+2 CLZ z_c+3
  sdy_store:      MIV stepcache_y,nx AZV rayindex,nx
                  LDZ z_c+0 STT nx
                  AIV 200,nx
                  LDZ z_c+1 STT nx
                  RTS
  sdy_hit:      LDZ rayindex LAB stepcache_y STZ z_c+0
                LDZ rayindex LAB stepcache_y+200 STZ z_c+1
                CLZ z_c+2 CLZ z_c+3
                RTS
#endif

.align

; -------------------------------------------------------------------------------------------
; draws a vertical line from (xa,ya) to (xa,yb)
; xa = x-Start-Position 0..399
; ya = y-Start-Position 0..239
; yb = height in pixels
; -------------------------------------------------------------------------------------------
VertLine:         RZP ya,BYTE1(0x0900),1 STZ index+1               ; use OS LineMSBTable: set top msb line start address
                  RZP ya,BYTE1(0x0800),1 STZ index+0               ; use OS LineLSBTable: set top lsb line start address
                  AZZ stride,index                           ; note: overflow is not possible
                  MZB pattern,vl_bitpat+1
  vl_bitpat:      LDI 0xcc ORT index STT index               ; index of left border
                  AIV 64,index DEZ yb FGT vl_bitpat          ; one line down
                    RTS

; ****************************************************************************
; Sets a pixel at position (xa, ya) without safety checking (highly optimized)
; ****************************************************************************
SetPixel:         RZP ya,BYTE1(0x0900),1 STZ index+1               ; calculate byte index using (xa,ya)
                  RZP ya,BYTE1(0x0800),1 STZ index+0 
                  AZZ stride,index                           ; note: overflow is not possible
                  LDZ pattern ORT index STT index            ; init bit pixel pattern
                  RTS

; ----------------------------------------------------------------------
; Fast (signed) multiplication (8-bit z_a) * (16-bit z_b) = (24-bit z_c)
; ----------------------------------------------------------------------

muls8_16f:
#ifdef USE_ACCELERATOR
            CLZ sign CLZ z_c+3                               ; clear sign; callers shift z_c as 32-bit
            CIZ 0,z_a FPL h_aposif                           ; test sign of A
              AIZ 0x80,sign NEZ z_a                          ; make negative A positive
  h_aposif: CIZ 0,z_b+1 FPL h_bposif                         ; test sign of B
              AIZ 0x80,sign NEV z_b                          ; make negative B positive
  h_bposif: MZB z_a,MULTIPLIER_A                             ; latch |A| once, reused for both products
            MZB z_b+0,MULTIPLIER_B                           ; |A| * B.lo -> z_c bytes 0..1
            MBZ MULTIPLIER_RESULT_LSB,z_c+0
            MBZ MULTIPLIER_RESULT_MSB,z_c+1
            MZB z_b+1,MULTIPLIER_B                           ; |A| * B.hi -> add into z_c bytes 1..2
            LDB MULTIPLIER_RESULT_LSB
            AD.Z z_c+1
            LDB MULTIPLIER_RESULT_MSB
            ACI 0                                            ; |A| <= 128 so MSB + carry cannot overflow
            STZ z_c+2
            RTS
#else
            CLQ z_c CLZ sign                                 ; clear result and sign
            CIZ 0,z_a FPL aposif                             ; test sign of A
              AIZ 0x80,sign NEZ z_a                          ; make negative A positive
  aposif:   CIZ 0,z_b+1 FPL bposif                           ; test sign of B
              AIZ 0x80,sign NEV z_b                          ; make B negative positive
  bposif:   LLZ z_a FPL sbit6off
              MVV z_b,z_c
  sbit6off: LLV z_c LLZ z_a FPL sbit5off
              AVV z_b,z_c LDI 0 AC.Z z_c+2
  sbit5off: LLQ z_c LLZ z_a FPL sbit4off
              AVV z_b,z_c LDI 0 AC.Z z_c+2
  sbit4off: LLQ z_c LLZ z_a FPL sbit3off
              AVV z_b,z_c LDI 0 AC.Z z_c+2
  sbit3off: LLQ z_c LLZ z_a FPL sbit2off
              AVV z_b,z_c LDI 0 AC.Z z_c+2
  sbit2off: LLQ z_c LLZ z_a FPL sbit1off
              AVV z_b,z_c LDI 0 AC.Z z_c+2
  sbit1off: LLQ z_c LLZ z_a FPL sbit0off
              AVV z_b,z_c LDI 0 AC.Z z_c+2
  sbit0off: RTS
#endif
.align

; -------------------------------------------------------------------------------
; Fast unsigned multiplication (8-bit z_a) * (16-bit z_b) = (24-bit z_c)
; -------------------------------------------------------------------------------
mulu8_16f:
#ifdef USE_ACCELERATOR
            CLZ z_c+3                                        ; callers test z_c+3 for overflow
            MZB z_a,MULTIPLIER_A                             ; latch A once, reused for both products
            MZB z_b+0,MULTIPLIER_B                           ; A * B.lo -> z_c bytes 0..1
            MBZ MULTIPLIER_RESULT_LSB,z_c+0
            MBZ MULTIPLIER_RESULT_MSB,z_c+1
            MZB z_b+1,MULTIPLIER_B                           ; A * B.hi -> add into z_c bytes 1..2
            LDB MULTIPLIER_RESULT_LSB
            AD.Z z_c+1
            LDB MULTIPLIER_RESULT_MSB
            ACI 0                                            ; MSB <= 0xfe so MSB + carry cannot overflow
            STZ z_c+2
            RTS
#else
            CLQ z_c LLZ z_a FCC ubit7off
              MVV z_b,z_c
  ubit7off: LLQ z_c LLZ z_a FCC ubit6off
              AVV z_b,z_c LDI 0 AC.Z z_c+2
  ubit6off: LLQ z_c LLZ z_a FCC ubit5off
              AVV z_b,z_c LDI 0 AC.Z z_c+2
  ubit5off: LLQ z_c LLZ z_a FCC ubit4off
              AVV z_b,z_c LDI 0 AC.Z z_c+2
  ubit4off: LLQ z_c LLZ z_a FCC ubit3off
              AVV z_b,z_c LDI 0 AC.Z z_c+2
  ubit3off: LLQ z_c LLZ z_a FCC ubit2off
              AVV z_b,z_c LDI 0 AC.Z z_c+2
  ubit2off: LLQ z_c LLZ z_a FCC ubit1off
              AVV z_b,z_c LDI 0 AC.Z z_c+2
  ubit1off: LLQ z_c LLZ z_a FCC ubit0off
              AVV z_b,z_c LDI 0 AC.Z z_c+2
  ubit0off: RTS                                              ; the sign is intentionally not applied to the result
#endif

; -----------------------------------------------------------------
; Fast unsigned division (17-bit z_a) / (16-bit z_b) = (17-bit z_c)
; -----------------------------------------------------------------
#ifdef FAST_DIVISION
; FAST_DIVISION version: quotient bit 16 can only be 1 when the top 16 bits of
; the dividend already reach the divisor, so that case is detected up front and
; signalled via z_c+2 (every caller clamps on z_c+1..z_c+3 and discards the
; quotient then). The main loop therefore needs only 16 iterations, can shift
; the quotient as a 16-bit word (LLV, 6cy vs LLQ, 10cy) and is unrolled 4x to
; cut loop-control overhead. Caller-visible results are identical.
.align
divu17_16f:     CLZ z_a+3 CLQ z_c                       ; set A extension = 0, result C = 0
                CZZ z_b+1,z_a+3 FCC d_start FGT d_over  ; would quotient bit 16 be set?
                  CZZ z_b+0,z_a+2 FCC d_start
  d_over:         INZ z_c+2                             ; yes: flag overflow for callers' clamp
                  RTS
  d_start:      MIZ 4,cnt
  d_loop:       LLV z_c LLQ z_a                         ; --- iteration 1 of 4
                CZZ z_b+1,z_a+3 FCC d_no1 FGT d_fit1    ; upper 16-bit A < B?
                  CZZ z_b+0,z_a+2 FCC d_no1
  d_fit1:           SVV z_b,z_a+2 INZ z_c+0             ; INZ is sufficient to set lowest bit of C
  d_no1:        LLV z_c LLQ z_a                         ; --- iteration 2 of 4
                CZZ z_b+1,z_a+3 FCC d_no2 FGT d_fit2
                  CZZ z_b+0,z_a+2 FCC d_no2
  d_fit2:           SVV z_b,z_a+2 INZ z_c+0
  d_no2:        LLV z_c LLQ z_a                         ; --- iteration 3 of 4
                CZZ z_b+1,z_a+3 FCC d_no3 FGT d_fit3
                  CZZ z_b+0,z_a+2 FCC d_no3
  d_fit3:           SVV z_b,z_a+2 INZ z_c+0
  d_no3:        LLV z_c LLQ z_a                         ; --- iteration 4 of 4
                CZZ z_b+1,z_a+3 FCC d_no4 FGT d_fit4
                  CZZ z_b+0,z_a+2 FCC d_no4
  d_fit4:           SVV z_b,z_a+2 INZ z_c+0
  d_no4:        DEZ cnt FGT d_loop
                  RTS
#else
stepdiv_x:      ; without FAST_DIVISION the slope call sites divide directly
stepdiv_y:
divu17_16f:     CLZ z_a+3 CLQ z_c                       ; set A extension = 0, result C = 0, sign = positive
                MIZ 17,cnt FPA d_entry                  ; and skip first shift of C
  d_next:         LLQ z_c LLQ z_a                       ; shift up existing result bits, shift up A
  d_entry:        CZZ z_b+1,z_a+3 FCC d_nofit FGT d_bfits ; upper 16-bit A < B?
                    CZZ z_b+0,z_a+2 FCC d_nofit
  d_bfits:            SVV z_b,z_a+2 INZ z_c+0           ; INZ is sufficient to set lowest bit of C
  d_nofit:        DEZ cnt FGT d_next
                    RTS
#endif

.align

costable:
  .byte 0x7f,0x7f,0x7f,0x7f,0x7e,0x7e,0x7e,0x7d,0x7d,0x7c,0x7b,0x7a,0x7a,0x79,0x78,0x76,
  .byte 0x75,0x74,0x73,0x71,0x70,0x6f,0x6d,0x6b,0x6a,0x68,0x66,0x64,0x62,0x60,0x5e,0x5c,
  .byte 0x5a,0x58,0x55,0x53,0x51,0x4e,0x4c,0x49,0x47,0x44,0x41,0x3f,0x3c,0x39,0x36,0x33,
  .byte 0x31,0x2e,0x2b,0x28,0x25,0x22,0x1f,0x1c,0x19,0x16,0x13,0x10,0x0c,0x09,0x06,0x03,
  .byte 0x00,0xfe,0xfb,0xf8,0xf5,0xf1,0xee,0xeb,0xe8,0xe5,0xe2,0xdf,0xdc,0xd9,0xd6,0xd3,
  .byte 0xd0,0xce,0xcb,0xc8,0xc5,0xc2,0xc0,0xbd,0xba,0xb8,0xb5,0xb3,0xb0,0xae,0xac,0xa9,
  .byte 0xa7,0xa5,0xa3,0xa1,0x9f,0x9d,0x9b,0x99,0x97,0x96,0x94,0x92,0x91,0x90,0x8e,0x8d,
  .byte 0x8c,0x8b,0x89,0x88,0x87,0x87,0x86,0x85,0x84,0x84,0x83,0x83,0x83,0x82,0x82,0x82,
  .byte 0x82,0x82,0x82,0x82,0x83,0x83,0x83,0x84,0x84,0x85,0x86,0x87,0x87,0x88,0x89,0x8b,
  .byte 0x8c,0x8d,0x8e,0x90,0x91,0x92,0x94,0x96,0x97,0x99,0x9b,0x9d,0x9f,0xa1,0xa3,0xa5,
  .byte 0xa7,0xa9,0xac,0xae,0xb0,0xb3,0xb5,0xb8,0xba,0xbd,0xc0,0xc2,0xc5,0xc8,0xcb,0xce,
  .byte 0xd0,0xd3,0xd6,0xd9,0xdc,0xdf,0xe2,0xe5,0xe8,0xeb,0xee,0xf1,0xf5,0xf8,0xfb,0xfe,
