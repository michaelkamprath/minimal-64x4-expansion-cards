#require __LANGUAGE_NAME__ == slu4-min64x4-asm
#require __LANGUAGE_VERSION__ >= 1.1.0
#use-scope "mathlib32"

.memzone ZERO_PAGE_APPS
#mute
_test_a:       .4byte 0
_test_b:       .4byte 0
_expect:       .8byte 0
_actual:       .8byte 0
_test_index:   .byte 0
#emit

.memzone USER_APPS
main:
    SPINIT
    JPS _Clear
    MIZ 0,_XPos
    MIZ 0,_YPos
    JPS _Print "Karatsuba 32-bit tests\n"
    CLZ _test_index

    ; 0x00000000 * 0x12345678 = 0x0000000000000000
    M4IQ 0x00000000,_test_a
    M4IQ 0x12345678,_test_b
    M4IQ 0x00000000,_expect
    M4IQ 0x00000000,_expect+4
    JPS run_test
    INZ _test_index

    ; 0x00010000 * 0x00010000 = 0x0000000100000000
    M4IQ 0x00010000,_test_a
    M4IQ 0x00010000,_test_b
    M4IQ 0x00000000,_expect
    M4IQ 0x00000001,_expect+4
    JPS run_test
    INZ _test_index

    ; 0xFFFFFFFF * 0xFFFFFFFF = 0xFFFFFFFE00000001
    M4IQ 0xFFFFFFFF,_test_a
    M4IQ 0xFFFFFFFF,_test_b
    M4IQ 0x00000001,_expect
    M4IQ 0xFFFFFFFE,_expect+4
    JPS run_test
    INZ _test_index

    ; 0xFFFF0000 * 0xFFFF0000 = 0xFFFE000100000000
    M4IQ 0xFFFF0000,_test_a
    M4IQ 0xFFFF0000,_test_b
    M4IQ 0x00000000,_expect
    M4IQ 0xFFFE0001,_expect+4
    JPS run_test
    INZ _test_index

    ; 0xFAE0C2BC * 0x6C2AB137 = 0x6A00A8B28FC5D264
    M4IQ 0xFAE0C2BC,_test_a
    M4IQ 0x6C2AB137,_test_b
    M4IQ 0x8FC5D264,_expect
    M4IQ 0x6A00A8B2,_expect+4
    JPS run_test
    INZ _test_index

    ; 0x80000000 * 0x80000000 = 0x4000000000000000
    M4IQ 0x80000000,_test_a
    M4IQ 0x80000000,_test_b
    M4IQ 0x00000000,_expect
    M4IQ 0x40000000,_expect+4
    JPS run_test
    INZ _test_index

    ; 0x0001FFFF * 0xFFFF0001 = 0x0001FFFD0002FFFF
    M4IQ 0x0001FFFF,_test_a
    M4IQ 0xFFFF0001,_test_b
    M4IQ 0x0002FFFF,_expect
    M4IQ 0x0001FFFD,_expect+4
    JPS run_test

    JPS _Print "All tests passed\n"
    JPS _WaitInput
    JPS _Prompt

run_test:
    ; push multiplicand (A) LSB -> MSB (stack expects MSB at lower address)
    LDZ _test_a+0
    PHS
    LDZ _test_a+1
    PHS
    LDZ _test_a+2
    PHS
    LDZ _test_a+3
    PHS
    ; push multiplier (B) LSB -> MSB (stack expects MSB at lower address)
    LDZ _test_b+0
    PHS
    LDZ _test_b+1
    PHS
    LDZ _test_b+2
    PHS
    LDZ _test_b+3
    PHS

    JPS ml32_unsigned_multiply

    ; pop result MSB -> LSB
    PLS
    STZ _actual+7
    PLS
    STZ _actual+6
    PLS
    STZ _actual+5
    PLS
    STZ _actual+4
    PLS
    STZ _actual+3
    PLS
    STZ _actual+2
    PLS
    STZ _actual+1
    PLS
    STZ _actual+0

    CZZ _expect+7,_actual+7
    BNE .mismatch
    CZZ _expect+6,_actual+6
    BNE .mismatch
    CZZ _expect+5,_actual+5
    BNE .mismatch
    CZZ _expect+4,_actual+4
    BNE .mismatch
    CZZ _expect+3,_actual+3
    BNE .mismatch
    CZZ _expect+2,_actual+2
    BNE .mismatch
    CZZ _expect+1,_actual+1
    BNE .mismatch
    CZZ _expect+0,_actual+0
    BNE .mismatch
    RTS

.mismatch:
    JPS _Print "Mismatch in test "
    LDZ _test_index
    JAS _PrintHex
    JPS _Print "\nA = "
    LDZ _test_a+3
    JAS _PrintHex
    LDZ _test_a+2
    JAS _PrintHex
    LDZ _test_a+1
    JAS _PrintHex
    LDZ _test_a+0
    JAS _PrintHex
    JPS _Print "\nB = "
    LDZ _test_b+3
    JAS _PrintHex
    LDZ _test_b+2
    JAS _PrintHex
    LDZ _test_b+1
    JAS _PrintHex
    LDZ _test_b+0
    JAS _PrintHex
    JPS _Print "\nEXP = "
    LDZ _expect+7
    JAS _PrintHex
    LDZ _expect+6
    JAS _PrintHex
    LDZ _expect+5
    JAS _PrintHex
    LDZ _expect+4
    JAS _PrintHex
    LDZ _expect+3
    JAS _PrintHex
    LDZ _expect+2
    JAS _PrintHex
    LDZ _expect+1
    JAS _PrintHex
    LDZ _expect+0
    JAS _PrintHex
    JPS _Print "\nACT = "
    LDZ _actual+7
    JAS _PrintHex
    LDZ _actual+6
    JAS _PrintHex
    LDZ _actual+5
    JAS _PrintHex
    LDZ _actual+4
    JAS _PrintHex
    LDZ _actual+3
    JAS _PrintHex
    LDZ _actual+2
    JAS _PrintHex
    LDZ _actual+1
    JAS _PrintHex
    LDZ _actual+0
    JAS _PrintHex
    JPS _Print "\n\n"
    JPS _WaitInput
    JPS _Prompt

#include "mathlib32.min64x4"
