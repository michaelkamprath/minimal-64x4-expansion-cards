	(text "CPU read of $FE70..$FE7F:\n  bit 0  up\n  bit 1  down\n  bit 2  left\n  bit 3  right\n  bit 4  fire\n  bits 5 to 7 always read 0\nA bit is 0 while its switch is closed."
		(exclude_from_sim no)
		(at 91.44 156.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "12ed6ea7-2245-494b-afec-33dd02a29a2c")
	)
	(text "CN1 stands for the whole breadboard adapter (Board A, the ribbon cable and Board B).\nSet SW1 on Board A to 7 (A7 off, A6 on, A5 on, A4 on) so the window is $FE70..$FE7F."
		(exclude_from_sim no)
		(at 25.4 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3b5492f2-14d1-4a1c-bb9c-7e0bdaadddbc")
	)
	(text "U1 drives the cable's data lines while ~{RO} is low. Board A passes them to the\nCPU only on a CPU read of $FE70..$FE7F; outside the window its own\ntransceiver is off. ~{MATCH} and A0..A3 are not needed.\nPin 1 (direction) is tied high: A to B."
		(exclude_from_sim no)
		(at 110.49 72.39 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "44359adc-8676-4e7d-a67f-c1fc136d2962")
	)
	(text "C1 next to U1."
		(exclude_from_sim no)
		(at 224.79 114.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "536be8ae-78db-468f-9cbc-b72774a8a7bb")
	)
	(text "J1: DE-9 with pins (male), as on the console.\nPin 7 (+5 V) and the paddle pins 5 and 9 are not used."
		(exclude_from_sim no)
		(at 41.402 126.746 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8bc91f63-c8e7-41a6-8e2a-64df4e4dba78")
	)
	(text "INH_REQ is tied high: Board A raises INH only on a CPU read\ninside the window, so no decode is needed on the breadboard."
		(exclude_from_sim no)
		(at 137.16 148.59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ad376394-3b0e-42b8-9026-3d94380678b3")
	)
	(text "Joystick adapter prototype, built on a breadboard behind the Minimal 64x4 breadboard adapter."
		(exclude_from_sim no)
		(at 25.4 20.32 0)
		(effects
			(font
				(size 1.905 1.905)
			)
			(justify left bottom)
		)
		(uuid "b23e0b90-35ba-4207-9aeb-130d20de72de")
	)
